# Copy this file to `.env` and fill in real values. Never commit `.env`.
# For Vercel: add these same variables in Project Settings > Environment Variables.

# PostgreSQL connection string.
# Local Docker example:  postgresql://postgres:postgres@localhost:5432/satact?schema=public
# Hosted (Neon / Vercel Postgres / Supabase): paste the pooled connection string here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/satact?schema=public"

# Secret token that unlocks the /admin dashboard. Make it long and random, e.g.:
#   openssl rand -hex 32
ADMIN_TOKEN="change-me-to-a-long-random-token"

# Public site name shown in the navbar and page titles.
NEXT_PUBLIC_SITE_NAME="Faryal Tutoring"
